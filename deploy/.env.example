# Copy to /srv/reglo-<env>/.env on the server. Never commit the real file.
COMPOSE_PROJECT_NAME=reglo-preprod
ENV_NAME=preprod
GHCR_OWNER=your-github-organization
IMAGE_TAG=latest
POSTGRES_DB=reglo
POSTGRES_USER=reglo
POSTGRES_PASSWORD=change-me
APP_SECRET=change-me
# NEXT_PUBLIC_USE_MOCKS (web) is inlined when the image is built, not read
# from this file: the web image uses mocks until the API endpoints exist.
